    BLOCK "041604b0"
    BEGIN
      VALUE "CompanyName", "GP3RT"
      VALUE "FileDescription", "GPxPatch GP3RT - configuracao do GPxPatch"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "GPxPatch GP3RT"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "GPxPatch GP3RT.exe"
      VALUE "LegalCopyright", "GP3RT. GPxPatch (c) Rene Smit."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x416, 1200
  END
END
